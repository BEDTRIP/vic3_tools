{
  "description": "A grep for a name, or a read of a whole big .gui/.txt, in game or mod folders gets the v3 index answer instead, once per session",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Grep|Bash|PowerShell|Read",
        "hooks": [
          {
            "type": "command",
            "command": "v3",
            "args": ["hook", "pre-tool-use"],
            "timeout": 30,
            "statusMessage": "v3: checking the index"
          }
        ]
      }
    ]
  }
}
